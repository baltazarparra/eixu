# Banco e autenticação administrativa
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ADMIN_PIN_PEPPER=
ADMIN_SESSION_SECRET=
ADMIN_INITIAL_PIN=

# IA, mídia e execução. Na Vercel, o Gateway usa VERCEL_OIDC_TOKEN
# automaticamente; AI_GATEWAY_API_KEY é somente o fallback fora dela.
AI_GATEWAY_API_KEY=
BLOB_READ_WRITE_TOKEN=
# ID do store separado com access=private, conectado ao projeto por OIDC.
STUDIO_BLOB_STORE_ID=
EIXU_IMAGE_MODEL=openai/gpt-image-2.5-sunburst
EIXU_CHROME_PATH=

# Publicação dos projetos de clientes na Vercel
EIXU_VERCEL_TOKEN=
# Configure o time também no ambiente de produção. VERCEL_ORG_ID é usado
# pelo CLI e não é uma variável de sistema injetada no runtime.
EIXU_VERCEL_TEAM_ID=
# Opcional quando VERCEL_PROJECT_ID está disponível. Sempre o projeto raiz.
# EIXU_VERCEL_ROOT_PROJECT_ID=

# Automação do Kanban
KANBAN_AGENT_TOKEN=
EIXU_KANBAN_URL=https://eixu.com.br

# Somente para o reset controlado; nunca apontar implicitamente para DATABASE_URL
EIXU_RESET_DATABASE_URL=
EIXU_RESET_PLATFORM_DEPLOYMENT_ID=
EIXU_RESET_RECOVERY_REF=
