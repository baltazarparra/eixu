# Banco e autenticação administrativa
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ADMIN_PIN_PEPPER=
ADMIN_SESSION_SECRET=
ADMIN_INITIAL_PIN=

# IA, mídia e execução. Na Vercel, o Gateway usa VERCEL_OIDC_TOKEN
# automaticamente; AI_GATEWAY_API_KEY é somente o fallback fora dela.
AI_GATEWAY_API_KEY=
BLOB_READ_WRITE_TOKEN=
# Store separado com access=private; nunca reutilizar o store público acima.
STUDIO_BLOB_READ_WRITE_TOKEN=
EIXU_IMAGE_MODEL=openai/gpt-image-2
EIXU_CHROME_PATH=

# Publicação dos projetos de clientes na Vercel
EIXU_VERCEL_TOKEN=
EIXU_VERCEL_BYPASS_MASTER_SECRET=
# Overrides opcionais para execução fora da Vercel. Em deployments, o Studio
# usa VERCEL_ORG_ID e VERCEL_PROJECT_ID, expostos automaticamente pelo sistema.
# EIXU_VERCEL_TEAM_ID=
# EIXU_VERCEL_ROOT_PROJECT_ID=

# Automação do Kanban
KANBAN_AGENT_TOKEN=
EIXU_KANBAN_URL=https://eixu.com.br

# Somente para o reset controlado; nunca apontar implicitamente para DATABASE_URL
EIXU_RESET_DATABASE_URL=
EIXU_RESET_PLATFORM_DEPLOYMENT_ID=
EIXU_RESET_RECOVERY_REF=
